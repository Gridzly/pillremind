
{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "medicines": {
          ".read": "auth != null && (auth.uid === $uid || root.child('connectionsByPatient').child(auth.uid).child($uid).child('status').val() === 'active')"
        },
        "reminders": {
          ".read": "auth != null && (auth.uid === $uid || root.child('connectionsByPatient').child(auth.uid).child($uid).child('status').val() === 'active')"
        }
      }
    },
    "connectionsByPatient": {
      "$patientUid": {
        ".read": "auth != null && auth.uid === $patientUid"
      }
    },
    "connectionsByCaregiver": {
      "$caregiverUid": {
        ".read": "auth != null && auth.uid === $caregiverUid"
      }
    }
  }
}
